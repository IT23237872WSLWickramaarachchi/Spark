<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft halo ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FFB5C8" />
        </shape>
    </item>
    <!-- Inner solid circle with secondaryContainer and subtle stroke -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/secondary_container" />
            <stroke
                android:width="1.5dp"
                android:color="@color/secondary" />
        </shape>
    </item>
</layer-list>
