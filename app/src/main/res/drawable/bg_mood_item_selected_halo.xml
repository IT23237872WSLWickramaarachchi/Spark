<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft glowing halo ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/mood_selected_halo" />
        </shape>
    </item>
    <!-- Inner solid circle with vibrant brand primary -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/mood_selected_bg" />
        </shape>
    </item>
</layer-list>
