<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme overrides -->
    <style name="Theme.Spark" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <!-- MD3 Primary Colors -->
        <item name="colorPrimary">@color/inverse_primary</item>
        <item name="colorOnPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- MD3 Secondary Colors -->
        <item name="colorSecondary">@color/secondary_fixed_dim</item>
        <item name="colorOnSecondary">@color/on_secondary_fixed</item>

        <!-- MD3 Surface & Background -->
        <item name="colorSurface">@color/inverse_surface</item>
        <item name="colorOnSurface">@color/inverse_on_surface</item>
        <item name="colorSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:colorBackground">@color/inverse_surface</item>
        <item name="android:windowBackground">@color/inverse_surface</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/inverse_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/inverse_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Material Component Style Defaults -->
        <item name="materialButtonStyle">@style/Widget.Spark.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.Spark.Card</item>
        <item name="textInputStyle">@style/Widget.Spark.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.Spark.Chip</item>
    </style>
</resources>