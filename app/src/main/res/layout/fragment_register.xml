<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_container_low"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Toolbar with Back Arrow + Centered "Spark" Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                android:textColor="@color/primary" />
        </FrameLayout>

        <!-- Main Content Card matching Reference Mockup -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRegister"
            style="@style/Widget.Spark.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="2dp">

            <!-- Vertical LinearLayout of Form Fields with gutter_stack spacing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="28dp">

                <!-- Header: "Create Account" Title -->
                <TextView
                    android:id="@+id/tvRegisterTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/register_title"
                    android:textAppearance="@style/TextAppearance.Spark.HeadlineLg"
                    android:textColor="@color/on_surface" />

                <!-- Subtitle: "Join Spark to begin your journey." -->
                <TextView
                    android:id="@+id/tvRegisterSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/register_subtitle"
                    android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                    android:textColor="@color/on_surface_variant" />

                <!-- 1. Full Name Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/register_label_name"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface" />

                <!-- 1. Full Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.Spark.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_hint_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Email Address Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gutter_stack"
                    android:layout_marginBottom="6dp"
                    android:text="@string/register_label_email"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface" />

                <!-- 2. Email Address Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.Spark.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/register_hint_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gutter_stack"
                    android:layout_marginBottom="6dp"
                    android:text="@string/register_label_password"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface" />

                <!-- 3. Password Input with Helper Text -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.Spark.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/outline"
                    app:helperText="@string/register_helper_password"
                    app:helperTextEnabled="true"
                    app:helperTextTextColor="@color/on_surface_variant"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="••••••••"
                        android:imeOptions="actionNext"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 4. Confirm Password Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gutter_stack"
                    android:layout_marginBottom="6dp"
                    android:text="@string/register_label_confirm_password"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface" />

                <!-- 4. Confirm Password Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.Spark.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/outline"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_key"
                    app:startIconTint="@color/outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="••••••••"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/outline" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Create Account Button with arrow icon -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    style="@style/Widget.Spark.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/register_btn_submit"
                    android:textAppearance="@style/TextAppearance.Spark.BodyMd" />

                <!-- Bottom Link Row: Already have an account? Log In -->
                <TextView
                    android:id="@+id/tvLoginPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="@string/register_prompt_login"
                    android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                    android:textColor="@color/on_surface_variant" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
