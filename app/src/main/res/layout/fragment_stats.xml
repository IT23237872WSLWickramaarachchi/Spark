<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Top App Bar: Back Arrow + "Spark" + Notifications Bell -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="@dimen/margin_screen">

                <ImageButton
                    android:id="@+id/ibToolbarBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Spark.HeadlineLg"
                    android:textColor="@color/primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/ibToolbarBell"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_notifications_title"
                    android:src="@drawable/ic_bell"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_surface_variant" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Screen Heading: "Your Progress" -->
            <TextView
                android:id="@+id/tvYourProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="@string/stats_your_progress"
                android:textAppearance="@style/TextAppearance.Spark.HeadlineLg"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <!-- Period Switcher: Week / Month Segmented Toggle -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_stats_toggle_container"
                android:padding="4dp"
                app:checkedButton="@id/btnPeriodWeek"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPeriodWeek"
                    style="@style/Widget.Spark.Button.Toggle.Stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_period_week"
                    tools:ignore="VisualLintButtonSize" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPeriodMonth"
                    style="@style/Widget.Spark.Button.Toggle.Stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_period_month"
                    tools:ignore="VisualLintButtonSize" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Card 1: Daily Completion Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCompletion"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row: Title + Subtitle on left, "82%" on right -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvCompletionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_completion_label"
                            android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvCompletionSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_completion_sublabel"
                            android:textAppearance="@style/TextAppearance.Spark.BodySm"
                            android:textColor="@color/on_surface_variant"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvCompletionTitle" />

                        <TextView
                            android:id="@+id/tvCompletionRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_completion_percentage_default"
                            android:textAppearance="@style/TextAppearance.Spark.DisplayHero"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="82%" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Daily Completion Bars Container -->
                    <LinearLayout
                        android:id="@+id/layoutCompletionBars"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <!-- Day 0 (Monday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay0"
                                android:layout_width="20dp"
                                android:layout_height="72dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_primary" />
                        </FrameLayout>

                        <!-- Day 1 (Tuesday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay1"
                                android:layout_width="20dp"
                                android:layout_height="96dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_primary" />
                        </FrameLayout>

                        <!-- Day 2 (Wednesday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay2"
                                android:layout_width="20dp"
                                android:layout_height="48dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:alpha="0.6"
                                android:background="@drawable/bg_chart_bar_primary" />
                        </FrameLayout>

                        <!-- Day 3 (Thursday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay3"
                                android:layout_width="20dp"
                                android:layout_height="108dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_primary" />
                        </FrameLayout>

                        <!-- Day 4 (Friday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay4"
                                android:layout_width="20dp"
                                android:layout_height="120dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_primary" />
                        </FrameLayout>

                        <!-- Day 5 (Saturday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay5"
                                android:layout_width="20dp"
                                android:layout_height="24dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_variant" />
                        </FrameLayout>

                        <!-- Day 6 (Sunday) -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <View
                                android:id="@+id/barDay6"
                                android:layout_width="20dp"
                                android:layout_height="12dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/bg_chart_bar_variant" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Subtle Horizontal Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/surface_variant" />

                    <!-- Day-of-Week Strip Using DayIndicatorView from Habit Detail -->
                    <LinearLayout
                        android:id="@+id/layoutDayIndicatorRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <!-- Day 0 (Monday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="M"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator0"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 1 (Tuesday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="T"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator1"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 2 (Wednesday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="W"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator2"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 3 (Thursday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="T"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator3"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 4 (Friday - Today) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="F"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator4"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 5 (Saturday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator5"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>

                        <!-- Day 6 (Sunday) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDay6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S"
                                android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                                android:textColor="@color/outline" />

                            <com.example.spark.ui.custom.DayIndicatorView
                                android:id="@+id/dayIndicator6"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Mood Trend Line Chart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoodTrend"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row: Title + Subtitle on left, Trend Pill on right -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvMoodTrendTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stats_mood_trend_label"
                            android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvMoodTrendSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stats_mood_trend_sublabel"
                            android:textAppearance="@style/TextAppearance.Spark.BodySm"
                            android:textColor="@color/on_surface_variant"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvMoodTrendTitle" />

                        <!-- Trend Pill (Positive) -->
                        <LinearLayout
                            android:id="@+id/layoutTrendPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_trend_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/ivTrendIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/secondary" />

                            <TextView
                                android:id="@+id/tvTrendStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/stats_mood_trend_positive"
                                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                                android:textColor="@color/secondary" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- MPAndroidChart LineChart with Smoothed Cubic Bezier Curve -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChartMood"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Stats Row: 2 Small Bento Cards Side by Side -->
            <LinearLayout
                android:id="@+id/layoutBottomStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Card: Current Streak -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStreak"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Circle Icon Badge: Flame -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stat_badge_flame">

                            <ImageView
                                android:id="@+id/ivStreakBadge"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_streak_flame"
                                app:tint="@color/secondary" />
                        </FrameLayout>

                        <!-- Streak Metric Value -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStreakValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_streak_value_default"
                                android:textAppearance="@style/TextAppearance.Spark.DisplayHero"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                tools:text="12" />

                            <TextView
                                android:id="@+id/tvStreakUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginBottom="4dp"
                                android:text="@string/stats_days_unit"
                                android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <!-- Label -->
                        <TextView
                            android:id="@+id/tvStreakLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.08"
                            android:text="@string/stats_current_streak_title"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Today's Rate -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTodayRate"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Circle Icon Badge: Check -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_stat_badge_check">

                            <ImageView
                                android:id="@+id/ivRateBadge"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <!-- Rate Metric Value -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTodayRateValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stats_today_rate_default"
                                android:textAppearance="@style/TextAppearance.Spark.DisplayHero"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                tools:text="4" />

                            <TextView
                                android:id="@+id/tvTodayRateTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:layout_marginBottom="4dp"
                                android:text="@string/stats_today_rate_total"
                                android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <!-- Label -->
                        <TextView
                            android:id="@+id/tvTodayRateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:letterSpacing="0.08"
