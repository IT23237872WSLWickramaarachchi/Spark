<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/moodSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/margin_screen"
    android:paddingBottom="28dp"
    tools:paddingTop="24dp"
    tools:theme="@style/Theme.Spark">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/selector_bottom_nav_pill"
        android:backgroundTint="@color/outline_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- "close" TextView top-right -->
    <TextView
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="close"
        android:textAppearance="@style/TextAppearance.Spark.LabelBold"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Script Title: "How are you feeling today?" -->
    <TextView
        android:id="@+id/tvMoodPrompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/font_caveat"
        android:gravity="center"
        android:text="@string/dashboard_daily_checkin_title"
        android:textColor="@color/primary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvClose"
        tools:text="How are you feeling today?" />

    <!-- Mood Icons Row (1 to 5) -->
    <LinearLayout
        android:id="@+id/layoutMoodIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMoodPrompt">

        <!-- Mood 1: Difficult -->
        <ImageView
            android:id="@+id/ivMood1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mood_item_unselected"
            android:clickable="true"
            android:contentDescription="@string/mood_level_1"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_1"
            app:tint="@color/on_surface_variant" />

        <!-- Mood 2: Low -->
        <ImageView
            android:id="@+id/ivMood2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mood_item_unselected"
            android:clickable="true"
            android:contentDescription="@string/mood_level_2"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_2"
            app:tint="@color/on_surface_variant" />

        <!-- Mood 3: Okay -->
        <ImageView
            android:id="@+id/ivMood3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mood_item_unselected"
            android:clickable="true"
            android:contentDescription="@string/mood_level_3"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_3"
            app:tint="@color/on_surface_variant" />

        <!-- Mood 4: Good -->
        <ImageView
            android:id="@+id/ivMood4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mood_item_unselected"
            android:clickable="true"
            android:contentDescription="@string/mood_level_4"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_4"
            app:tint="@color/on_surface_variant" />

        <!-- Mood 5: Radiant -->
        <ImageView
            android:id="@+id/ivMood5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_mood_item_unselected"
            android:clickable="true"
            android:contentDescription="@string/mood_level_5"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_5"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Optional Note Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMoodNote"
        style="@style/Widget.Spark.TextInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutMoodIcons"
        app:layout_constraintWidth_max="488dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMoodNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Add a note (optional)..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:textAppearance="@style/TextAppearance.Spark.BodyMd"
            android:textColor="@color/on_surface" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Mood Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveMood"
        style="@style/Widget.Spark.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:enabled="false"
        android:text="@string/mood_btn_save"
        app:layout_constraintWidth_max="320dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilMoodNote" />

    <!-- "Skip for today" Text Link -->
    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="8dp"
        android:text="Skip for today"
        android:textAppearance="@style/TextAppearance.Spark.LabelBold"
        android:textColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSaveMood" />

</androidx.constraintlayout.widget.ConstraintLayout>
