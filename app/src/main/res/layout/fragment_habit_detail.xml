<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_cream"
    tools:theme="@style/Theme.Spark">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="108dp">

            <!-- Top App Bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="@dimen/margin_screen">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvHabitTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Morning Run"
                    android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                    android:textColor="@color/primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnOverflow"
                    app:layout_constraintStart_toEndOf="@+id/ivBack"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Morning Run" />

                <ImageButton
                    android:id="@+id/btnOverflow"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More options"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_more_vert"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_surface_variant" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Streak Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStreak"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:padding="24dp">

                    <!-- Watermark decorative flame in top-right -->
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="-28dp"
                        android:layout_marginTop="-28dp"
                        android:alpha="0.10"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_streak_flame"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                    <!-- Center Flame Icon -->
                    <ImageView
                        android:id="@+id/ivStreakFlame"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_streak_flame"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />

                    <!-- Current Streak Display -->
                    <TextView
                        android:id="@+id/tvStreakDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="12 Day Streak"
                        android:textAppearance="@style/TextAppearance.Spark.DisplayHero"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivStreakFlame"
                        tools:text="12 Day Streak" />

                    <!-- Best Streak Subtitle -->
                    <TextView
                        android:id="@+id/tvBestStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Best streak: 21 days"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/primary_fixed_dim"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStreakDays"
                        tools:text="Best streak: 21 days" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "This Week" Header -->
            <TextView
                android:id="@+id/tvSectionThisWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="This Week"
                android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <!-- "This Week" Bento Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeeklyProgress"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="20dp"
                    android:weightSum="7">

                    <!-- Day 0: Monday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="M"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator0"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 1: Tuesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator1"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 2: Wednesday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="W"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator2"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 3: Thursday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="T"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator3"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 4: Friday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="F"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface"
                            android:textStyle="bold" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator4"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 5: Saturday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator5"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Day 6: Sunday -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDay6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="S"
                            android:textAppearance="@style/TextAppearance.Spark.LabelMd"
                            android:textColor="@color/on_surface_variant" />

                        <com.example.spark.ui.custom.DayIndicatorView
                            android:id="@+id/dayIndicator6"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "Notes" Section Header -->
            <TextView
                android:id="@+id/tvSectionNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="Notes"
                android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />

            <!-- "Notes" Bento Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:minHeight="120dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvNotes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Feeling great this week. Trying to keep the pace steady and not push too hard on the hills."
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface_variant"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btnEditNotes"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Feeling great this week. Trying to keep the pace steady and not push too hard on the hills." />

                    <ImageButton
                        android:id="@+id/btnEditNotes"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_edit"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_edit"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:tint="@color/primary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Action Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_container_lowest"
        android:elevation="8dp"
        android:paddingHorizontal="@dimen/margin_screen"
        android:paddingVertical="16dp">

        <!-- Edit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditHabit"
            style="@style/Widget.Spark.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteHabit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/action_edit"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconTint="@color/primary" />

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteHabit"
            style="@style/Widget.Spark.Button.Delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintWidth_max="320dp"
            app:layout_constraintStart_toEndOf="@id/btnEditHabit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/action_delete"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
