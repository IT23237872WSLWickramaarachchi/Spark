<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Top Curved Header: Back Button + "Settings" Title + Bell Button -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_header"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="12dp"
                android:paddingBottom="28dp">

                <ImageButton
                    android:id="@+id/ibToolbarBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_primary" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/ibToolbarBell"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_notifications_title"
                    android:src="@drawable/ic_bell"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/on_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_screen"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- ========================================================= -->
                <!-- 1. ACCOUNT SECTION                                        -->
                <!-- ========================================================= -->
                <TextView
                    android:id="@+id/tvAccountHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_section_account"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface_variant" />

                <!-- Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfile"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/ivProfileAvatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@null"
                            android:src="@drawable/sample_avatar"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/layoutProfileText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/ivProfileChevron"
                            app:layout_constraintStart_toEndOf="@+id/ivProfileAvatar"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvProfileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_profile_name"
                                android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
                                android:textColor="@color/on_surface"
                                android:textStyle="bold"
                                tools:text="Alex Johnson" />

                            <TextView
                                android:id="@+id/tvProfileSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/settings_profile_view"
                                android:textAppearance="@style/TextAppearance.Spark.BodySm"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivProfileChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/outline_variant" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================= -->
                <!-- 2. PREFERENCES SECTION                                    -->
                <!-- ========================================================= -->
                <TextView
                    android:id="@+id/tvPreferencesHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_section_preferences"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface_variant" />

                <!-- Row 1: Notifications -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNotifications"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <include
                        android:id="@+id/rowNotifications"
                        layout="@layout/item_settings_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 2: Dark Mode -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDarkMode"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <include
                        android:id="@+id/rowDarkMode"
                        layout="@layout/item_settings_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 3: Reminder Time -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReminderTime"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <include
                        android:id="@+id/rowReminderTime"
                        layout="@layout/item_settings_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 4: Language -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLanguage"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <include
                        android:id="@+id/rowLanguage"
                        layout="@layout/item_settings_row" />
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================================= -->
                <!-- 3. ABOUT SECTION                                          -->
                <!-- ========================================================= -->
                <TextView
                    android:id="@+id/tvAboutHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_section_about"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                    android:textColor="@color/on_surface_variant" />

                <!-- About Card with Help Center and Privacy Policy -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbout"
                    style="@style/Widget.Spark.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Row 5: Help Center -->
                        <include
                            android:id="@+id/rowHelpCenter"
                            layout="@layout/item_settings_row" />

                        <!-- Divider line -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/surface_variant" />

                        <!-- Row 6: Privacy Policy -->
                        <include
                            android:id="@+id/rowPrivacyPolicy"
                            layout="@layout/item_settings_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Full-Width Outlined Log Out Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogOut"
                    style="@style/Widget.Spark.Button.LogOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/settings_log_out"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/error" />

                <!-- App Version -->
                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:text="@string/settings_app_version"
                    android:textAppearance="@style/TextAppearance.Spark.BodySm"
                    android:textColor="@color/outline_variant" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
