<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/selector_bottom_nav_pill"
        android:backgroundTint="@color/outline_variant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Row: Title + Close Button -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/add_habit_header"
        android:textAppearance="@style/TextAppearance.Spark.HeadlineLg"
        android:textColor="@color/on_surface"
        app:layout_constraintEnd_toStartOf="@+id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dragHandle" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_close"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@+id/tvHeaderTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvHeaderTitle"
        app:tint="@color/outline" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveHabit"
        app:layout_constraintHeight_max="540dp"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Habit Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/add_habit_name_label"
                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                android:textColor="@color/on_surface" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHabitName"
                style="@style/Widget.Spark.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHabitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_habit_name_hint_placeholder"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                    android:textColor="@color/on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/add_habit_category_label"
                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                android:textColor="@color/on_surface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHealth"
                    style="@style/Widget.Spark.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/add_habit_category_health" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMindfulness"
                    style="@style/Widget.Spark.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_habit_category_mindfulness" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipProductivity"
                    style="@style/Widget.Spark.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_habit_category_productivity" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Frequency Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/add_habit_frequency_label"
                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                android:textColor="@color/on_surface" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnDaily"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDaily"
                    style="@style/Widget.Spark.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_habit_freq_daily" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeekly"
                    style="@style/Widget.Spark.Button.Toggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_habit_freq_weekly" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Reminder Time Clickable Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/add_habit_reminder_time_label"
                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                android:textColor="@color/on_surface" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReminderTime"
                style="@style/Widget.Spark.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/ivClock"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvReminderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/add_habit_reminder_time_label"
                        android:textAppearance="@style/TextAppearance.Spark.BodyMd"
                        android:textColor="@color/on_surface"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivClock"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="08:00 AM"
                        android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                        android:textColor="@color/primary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivChevron"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/outline" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Color Swatch Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/add_habit_color_label"
                android:textAppearance="@style/TextAppearance.Spark.LabelBold"
                android:textColor="@color/on_surface" />

            <LinearLayout
                android:id="@+id/layoutColorSwatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Swatch 1: Primary Lilac (#52559C) -->
                <FrameLayout
                    android:id="@+id/swatch1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/ring1"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_color_swatch_ring"
                        android:visibility="visible" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_bottom_nav_pill"
                        android:backgroundTint="#52559C" />
                </FrameLayout>

                <!-- Swatch 2: Emerald Green (#1C8554) -->
                <FrameLayout
                    android:id="@+id/swatch2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/ring2"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_color_swatch_ring"
                        android:visibility="invisible" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_bottom_nav_pill"
                        android:backgroundTint="#1C8554" />
                </FrameLayout>

                <!-- Swatch 3: Rose Coral (#874D5E) -->
                <FrameLayout
                    android:id="@+id/swatch3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/ring3"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_color_swatch_ring"
                        android:visibility="invisible" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_bottom_nav_pill"
                        android:backgroundTint="#874D5E" />
                </FrameLayout>

                <!-- Swatch 4: Ocean Blue (#2563EB) -->
                <FrameLayout
                    android:id="@+id/swatch4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/ring4"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_color_swatch_ring"
                        android:visibility="invisible" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_bottom_nav_pill"
                        android:backgroundTint="#2563EB" />
                </FrameLayout>

                <!-- Swatch 5: Amber Orange (#D97706) -->
                <FrameLayout
                    android:id="@+id/swatch5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:id="@+id/ring5"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_color_swatch_ring"
                        android:visibility="invisible" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/selector_bottom_nav_pill"
                        android:backgroundTint="#D97706" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save Habit Button (Pinned to Bottom) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveHabit"
        style="@style/Widget.Spark.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_screen"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/add_habit_btn_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
