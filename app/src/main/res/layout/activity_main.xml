<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Custom Bottom Navigation matching Reference Mockup -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 1. Home (Dashboard) -->
            <FrameLayout
                android:id="@+id/navItemHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/indicatorHome"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_active_pill">

                    <ImageView
                        android:id="@+id/ivNavHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_dashboard"
                        android:src="@drawable/ic_home"
                        app:tint="@color/on_primary" />
                </FrameLayout>
            </FrameLayout>

            <!-- 2. Statistics -->
            <FrameLayout
                android:id="@+id/navItemStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/indicatorStats"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivNavStats"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_stats"
                        android:src="@drawable/ic_chart"
                        app:tint="@color/on_surface_variant" />
                </FrameLayout>
            </FrameLayout>

            <!-- 3. Add Habit (+) Action -->
            <FrameLayout
                android:id="@+id/navItemAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/indicatorAdd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivNavAdd"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_add"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/on_surface_variant" />
                </FrameLayout>
            </FrameLayout>

            <!-- 4. Mood Modal Action -->
            <FrameLayout
                android:id="@+id/navItemMood"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/indicatorMood"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivNavMood"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_mood"
                        android:src="@drawable/ic_mood_smile"
                        app:tint="@color/on_surface_variant" />
                </FrameLayout>
            </FrameLayout>

            <!-- 5. Settings -->
            <FrameLayout
                android:id="@+id/navItemSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/indicatorSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/ivNavSettings"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_settings"
                        android:src="@drawable/ic_gear"
                        app:tint="@color/on_surface_variant" />
                </FrameLayout>
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>