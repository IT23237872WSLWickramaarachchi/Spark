<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Spark.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfileAvatarLarge"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Spark.Circle"
            app:strokeColor="@color/surface_card"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:textAppearance="@style/TextAppearance.Spark.HeadlineMd"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Alex Johnson" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textAppearance="@style/TextAppearance.Spark.BodyMd"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="alex@example.com" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePhoto"
            style="@style/Widget.Spark.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:text="Change Profile Photo"
            android:textAppearance="@style/TextAppearance.Spark.LabelBold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseProfile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="@string/action_close"
            android:textAppearance="@style/TextAppearance.Spark.BodySm"
            android:textColor="@color/primary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
