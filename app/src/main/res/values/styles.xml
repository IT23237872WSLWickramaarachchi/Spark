<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================= -->
    <!-- SHAPE APPEARANCES (Corner Radii from DESIGN.md)                   -->
    <!-- ================================================================= -->
    <style name="ShapeAppearance.Spark.Corner.Sm" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.Spark.Corner.Default" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_default</item>
    </style>

    <style name="ShapeAppearance.Spark.Corner.Md" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.Spark.Corner.Lg" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="ShapeAppearance.Spark.Corner.Xl" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="ShapeAppearance.Spark.Corner.Full" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_full</item>
    </style>

    <!-- ================================================================= -->
    <!-- TEXT APPEARANCES (Typography from DESIGN.md)                      -->
    <!-- ================================================================= -->
    <!-- Display Hero: 32sp, 700 bold, Plus Jakarta Sans, lineHeight 40sp, letterSpacing -0.02 -->
    <style name="TextAppearance.Spark.DisplayHero" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">40sp</item>
        <item name="android:lineHeight" tools:targetApi="p">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Script Title from Stitch: 64sp, Caveat font, on_primary color -->
    <style name="TextAppearance.Spark.ScriptTitle" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">cursive</item>
        <item name="android:fontFamily">cursive</item>
        <item name="android:textSize">64sp</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <!-- Script Welcome: 44sp, Caveat font, on_primary color -->
    <style name="TextAppearance.Spark.ScriptWelcome" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">cursive</item>
        <item name="android:fontFamily">cursive</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <!-- Headline Lg: 24sp, 700 bold, Plus Jakarta Sans, lineHeight 32sp -->
    <style name="TextAppearance.Spark.HeadlineLg" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">32sp</item>
        <item name="android:lineHeight" tools:targetApi="p">32sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Headline Md: 20sp, 600 semibold, Plus Jakarta Sans, lineHeight 28sp -->
    <style name="TextAppearance.Spark.HeadlineMd" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">28sp</item>
        <item name="android:lineHeight" tools:targetApi="p">28sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Title Lg: 18sp, 700 bold, Plus Jakarta Sans -->
    <style name="TextAppearance.Spark.TitleLg" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Title Md: 16sp, 600 semibold, Plus Jakarta Sans -->
    <style name="TextAppearance.Spark.TitleMd" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Body Lg: 18sp, 400 regular, Nunito Sans, lineHeight 26sp -->
    <style name="TextAppearance.Spark.BodyLg" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">26sp</item>
        <item name="android:lineHeight" tools:targetApi="p">26sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Body Md: 16sp, 400 regular, Nunito Sans, lineHeight 24sp -->
    <style name="TextAppearance.Spark.BodyMd" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">24sp</item>
        <item name="android:lineHeight" tools:targetApi="p">24sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Body Sm: 14sp, 400 regular, Nunito Sans, lineHeight 20sp -->
    <style name="TextAppearance.Spark.BodySm" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">20sp</item>
        <item name="android:lineHeight" tools:targetApi="p">20sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Label Bold: 14sp, 700 bold, Nunito Sans, lineHeight 18sp, letterSpacing 0.05 -->
    <style name="TextAppearance.Spark.LabelBold" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">18sp</item>
        <item name="android:lineHeight" tools:targetApi="p">18sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Label Md: 12sp, 600 semibold, Nunito Sans, lineHeight 16sp -->
    <style name="TextAppearance.Spark.LabelMd" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">16sp</item>
        <item name="android:lineHeight" tools:targetApi="p">16sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Label Sm: 11sp, 700 bold, Nunito Sans, lineHeight 14sp -->
    <style name="TextAppearance.Spark.LabelSm" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">14sp</item>
        <item name="android:lineHeight" tools:targetApi="p">14sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- ================================================================= -->
    <!-- WIDGET STYLES                                                     -->
    <!-- ================================================================= -->
    <!-- Widget.Spark.Button.Primary: 56dp minHeight, radius_lg corner, colorPrimary background -->
    <style name="Widget.Spark.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Lg</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.BodyMd</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">@dimen/elevation_button</item>
    </style>

    <!-- Widget.Spark.Button.Ghost: no background, colorPrimary text & stroke -->
    <style name="Widget.Spark.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Lg</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.BodyMd</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Widget.Spark.Card: radius_xl corners, surfaceContainerLowest background, soft elevation -->
    <style name="Widget.Spark.Card" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Xl</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardMaxElevation">@dimen/elevation_card</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>

    <!-- Widget.Spark.TextInputLayout: radius_lg corner, outline box style -->
    <style name="Widget.Spark.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Lg</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_lg</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_lg</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/surface_container_lowest</item>
        <item name="hintTextColor">@color/outline</item>
    </style>

    <!-- Widget.Spark.Chip: single selectable pill chip for habit categories & tags -->
    <style name="Widget.Spark.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Full</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.LabelBold</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.Spark.Chip.Choice" parent="Widget.Spark.Chip" />

    <!-- Widget.Spark.Button.Toggle: Segmented toggle button for Daily/Weekly -->
    <style name="Widget.Spark.Button.Toggle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">48dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.LabelBold</item>
        <item name="backgroundTint">@color/selector_segmented_button_tint</item>
        <item name="android:textColor">@color/selector_segmented_button_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Widget.Spark.Button.Toggle.Stats: Segmented pill toggle button for Week/Month in Stats -->
    <style name="Widget.Spark.Button.Toggle.Stats" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">40dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Full</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.LabelBold</item>
        <item name="backgroundTint">@color/selector_stats_toggle_tint</item>
        <item name="android:textColor">@color/selector_stats_toggle_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!-- Bottom Sheet Dialog Styles -->
    <style name="Widget.Spark.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Spark.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_container_lowest</item>
    </style>

    <style name="Widget.Spark.BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <!-- Widget.Spark.Button.Delete: Soft pink container button for delete action matching reference -->
    <style name="Widget.Spark.Button.Delete" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Lg</item>
        <item name="backgroundTint">@color/secondary_container</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="iconTint">@color/on_secondary_container</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.LabelBold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Widget.Spark.Switch: Switch with custom thumb and track colors -->
    <style name="Widget.Spark.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/selector_switch_thumb</item>
        <item name="trackTint">@color/selector_switch_track</item>
    </style>

    <!-- Widget.Spark.Button.LogOut: Full-width outlined button with error styling -->
    <style name="Widget.Spark.Button.LogOut" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spark.Corner.Xl</item>
        <item name="backgroundTint">@color/surface_container_lowest</item>
        <item name="strokeColor">@color/surface_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Spark.HeadlineMd</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">@dimen/elevation_card</item>
    </style>

</resources>
